@using LuneiSoleiPortfolio.App.Components
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton ButtonType="ButtonType.Button" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" 
                       Edge="Edge.Start" OnClick="@((evt) => DrawerToggle())"/>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen">
        <MudDrawerHeader>Navigation</MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code
{
    bool _drawerOpen = true;
    
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
